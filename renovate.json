{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>adfinis/renovate-config",
    "github>adfinis/renovate-config:app",
    "github>adfinis/renovate-config:quiet",
    "github>adfinis/renovate-config:lockfile-maintenance",
    "github>projectpotos/renovate-config:potos-deps"
  ],
  "packageRules": [
    {
      "description": "This repo provides a Fedora 44 image, update the digest only",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/library/fedora"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "enabled": false
    }
  ]
}
